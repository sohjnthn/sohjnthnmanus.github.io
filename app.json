{
  "expo": {
    "name": "MapleStorySEA Tips",
    "slug": "my-manus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/FB_IMG_1785846587835.png",
    "scheme": "mymanusapp",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/FB_IMG_1785846587835.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.maplestorysea.tipsapp",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/FB_IMG_1785846587835.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/FB_IMG_1785846587835.png",
          "resizeMode": "cover",
          "imageWidth": 1284,
          "backgroundColor": "#AFEEEE"
        }
      ],
      "expo-asset",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "f249ae59-8009-486f-9775-16a1ffa92e1d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f249ae59-8009-486f-9775-16a1ffa92e1d"
    }
  }
}